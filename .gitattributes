* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
# SQLx hashes the exact migration bytes. Existing SCBL databases were created
# from CRLF migrations, so these files are an immutable compatibility surface.
server/dedicated-server/src/storage/migrations/*.sql text eol=crlf
*.ps1 text eol=crlf
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
*.png binary
*.ico binary
*.mp3 binary
*.wav binary
*.dll binary
*.sav binary
*.meta binary
