<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <RootNamespace>SplinterCellCNLauncher</RootNamespace>
    <AssemblyName>SplinterCellCNLauncher</AssemblyName>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="users.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Services\NetworkRiskService.cs" />
    <None Remove="Services\NetworkRiskService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="logo.ico" />
  </ItemGroup>

  <!-- Save templates remain embedded because they are tiny and versioned with Launcher behavior.
       Hooks is deliberately excluded: the full package carries it under bootstrap-components/
       and runtime updates resolve it through the signed component channel. -->
  <ItemGroup>
    <None Remove="EmbeddedFiles\**\*" />
    <EmbeddedResource Include="EmbeddedFiles\**\*" Exclude="EmbeddedFiles\uplay_r1_loader.dll" />
  </ItemGroup>

  <Import Project="..\SCBL.Version.props" />
</Project>
